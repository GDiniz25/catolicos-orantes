---
/**
 * Roteiro da novena em etapas: uma oração por vez, na ordem certa, avançando para o lado
 * (botões Anterior e Próximo, toque deslizando ou setas do teclado).
 * Início (escolha do dia) → oração inicial → oração do dia → oração da novena → oração final → ladainha → concluir.
 * O dia rezado fica salvo no aparelho (e na conta, se houver login) e a página já abre no próximo.
 * Sem JavaScript, todas as etapas aparecem em sequência.
 */
import { blocoOracoesBasicas, comOracoesBasicas, lerOracoesBasicas, SINAL_DA_CRUZ, SINAL_FINAL, type NovenaGuiada, type OracoesBasicas } from '@/lib/novenaGuiada';
interface Props { guia: NovenaGuiada; id: string; nome: string }
const { guia, id, nome } = Astro.props;
const temDias = guia.dias.length === 9;

// Onde a novena manda rezar Pai-Nosso, Ave-Maria e Glória, o texto completo aparece logo abaixo
const proc = (h?: string | null) => (h ? comOracoesBasicas(h) : null);
const inicialP = proc(guia.inicial?.html);
const diasP = guia.dias.map((d) => proc(d.html)!);
const suplicaP = proc(guia.suplica?.html);
const finalP = proc(guia.final?.html);
const achouNoRoteiro = [inicialP, suplicaP, finalP, ...diasP].some((x) => x?.achou);
// Se a instrução só aparece na explicação do artigo, essas orações ganham uma etapa própria
let basicas: OracoesBasicas | null = null;
if (!achouNoRoteiro) {
  const texto = `${guia.roteiro?.html ?? ''} ${guia.artigo}`.replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ').replace(/\s+/g, ' ');
  const frase = texto.split(/(?<=[.;])\s/).find((f) => lerOracoesBasicas(f));
  basicas = frase ? lerOracoesBasicas(frase) : null;
  // "…, Pai-Nosso, Ave-Maria e Glória, …" sem número: um de cada
  if (!basicas && /pai[- ]nosso,\s*ave[- ]maria\s+e\s+glória/i.test(texto)) basicas = { pai: 1, ave: 1, gloria: 1 };
}
const nomesBasicas = basicas ? [basicas.pai && 'Pai-Nosso', basicas.ave && 'Ave-Maria', basicas.gloria && 'Glória'].filter(Boolean) as string[] : [];
const rotuloBasicas = nomesBasicas.length > 1 ? `${nomesBasicas.slice(0, -1).join(', ')} e ${nomesBasicas[nomesBasicas.length - 1]}` : nomesBasicas[0] ?? '';

type Etapa = { chave: string; rotulo: string };
const etapas: Etapa[] = [{ chave: 'inicio', rotulo: 'Início' }];
if (guia.inicial) etapas.push({ chave: 'inicial', rotulo: 'Oração inicial' });
if (temDias) etapas.push({ chave: 'dia', rotulo: 'Oração do dia' });
if (basicas) etapas.push({ chave: 'basicas', rotulo: rotuloBasicas });
if (guia.suplica) etapas.push({ chave: 'suplica', rotulo: 'Oração da novena' });
if (guia.final) etapas.push({ chave: 'final', rotulo: /^oração final/i.test(guia.final.titulo) ? 'Oração final' : guia.final.titulo.split(/[:(]/)[0].trim() });
if (guia.ladainha) etapas.push({ chave: 'ladainha', rotulo: 'Ladainha' });
etapas.push({ chave: 'fim', rotulo: 'Concluir' });
const idx = (c: string) => etapas.findIndex((e) => e.chave === c);
const nomeCurto = nome.split(/[:|]/)[0].trim();
---
<section id="reze-a-novena" class="guia-novena not-prose my-10 rounded-xl border border-co-warm-sand-dark bg-white" data-guia={id} aria-labelledby="reze-a-novena-titulo">
  <div class="rounded-t-xl border-b border-co-warm-sand-dark bg-co-warm-cream/70 p-5 md:p-7">
    <h2 id="reze-a-novena-titulo" class="font-display text-2xl font-semibold leading-snug text-co-warm-brown md:text-[1.75rem]">Reze a novena</h2>
    <p class="mt-2 text-[16px] leading-relaxed text-co-warm-brown/85" data-guia-status>
      Escolha o dia e siga as orações uma de cada vez, na ordem. Ao terminar, marque o dia como rezado.
    </p>
    <div class="mt-4" role="group" aria-label="Dia da novena">
      <div class="grid grid-cols-9 gap-1 sm:gap-2">
        {Array.from({ length: 9 }, (_, i) => (
          <button type="button" data-guia-escolher={i} aria-label={`${i + 1}º dia`} aria-pressed={i === 0 ? 'true' : 'false'}
            class="dia-btn relative flex h-11 min-w-0 items-center justify-center rounded-md border border-co-warm-sand-dark bg-white text-[16px] font-semibold text-co-warm-brown hover:border-co-warm-brown/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-co-warm-terracotta focus-visible:ring-offset-1 sm:h-12 sm:text-[17px]">
            {i + 1}
            <span class="dia-feito absolute right-0.5 top-0.5 hidden h-3.5 w-3.5 items-center justify-center rounded-full bg-co-warm-brown text-white sm:right-1 sm:top-1" aria-hidden="true">
              <svg viewBox="0 0 12 12" class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="2"><path d="M2.5 6.2l2.3 2.3 4.7-5" /></svg>
            </span>
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- Trilha das etapas: mostra onde a pessoa está e permite pular para uma etapa -->
  <nav class="trilha border-b border-co-warm-sand-dark" aria-label="Etapas da oração" data-guia-trilha hidden>
    <ol>
      {etapas.map((e, i) => (
        <li><button type="button" data-guia-ir={i}><span class="trilha-num" aria-hidden="true">{i + 1}</span><span class="trilha-rotulo">{e.rotulo}</span></button></li>
      ))}
    </ol>
  </nav>

  <div class="guia-corpo article-prose px-5 py-6 md:px-7" data-guia-palco aria-live="polite">
    <div class="etapa" data-guia-etapa={idx('inicio')}>
      <p class="etapa-sobre">Etapa 1 de {etapas.length}</p>
      <h3 class="etapa-titulo" data-guia-dia-titulo>1º dia da novena</h3>
      <p>Reserve alguns minutos em silêncio. Comece com o sinal da cruz:</p>
      <blockquote><p>{SINAL_DA_CRUZ}</p></blockquote>
      <p>Apresente a Deus a sua intenção. Depois, siga as etapas na ordem:</p>
      <ol class="etapa-lista">
        {etapas.slice(1, -1).map((e) => <li>{e.chave === 'dia' ? 'Oração e meditação do dia' : e.rotulo}</li>)}
      </ol>
      {guia.roteiro && (
        <details class="etapa-detalhe">
          <summary>Como esta novena é rezada</summary>
          <Fragment set:html={guia.roteiro.html} />
        </details>
      )}
    </div>

    {guia.inicial && (
      <div class="etapa" data-guia-etapa={idx('inicial')}>
        <p class="etapa-sobre">Etapa {idx('inicial') + 1} de {etapas.length}</p>
        <h3 class="etapa-titulo">Oração inicial</h3>
        <Fragment set:html={inicialP!.html} />
      </div>
    )}

    {temDias && (
      <div class="etapa" data-guia-etapa={idx('dia')}>
        <p class="etapa-sobre">Etapa {idx('dia') + 1} de {etapas.length}</p>
        {guia.dias.map((d, i) => (
          <div data-guia-dia={i} hidden={i !== 0}>
            <h3 class="etapa-titulo">{d.titulo}</h3>
            <Fragment set:html={diasP[i].html} />
          </div>
        ))}
      </div>
    )}

    {basicas && (
      <div class="etapa" data-guia-etapa={idx('basicas')}>
        <p class="etapa-sobre">Etapa {idx('basicas') + 1} de {etapas.length}</p>
        <h3 class="etapa-titulo">{rotuloBasicas}</h3>
        <p>Reze agora {[basicas.pai && `${basicas.pai > 1 ? basicas.pai : 'um'} Pai-Nosso`, basicas.ave && `${basicas.ave > 1 ? `${basicas.ave} Ave-Marias` : 'uma Ave-Maria'}`, basicas.gloria && 'um Glória'].filter(Boolean).join(', ').replace(/, ([^,]*)$/, ' e $1')}:</p>
        <Fragment set:html={blocoOracoesBasicas(basicas)} />
      </div>
    )}

    {guia.suplica && (
      <div class="etapa" data-guia-etapa={idx('suplica')}>
        <p class="etapa-sobre">Etapa {idx('suplica') + 1} de {etapas.length}</p>
        <h3 class="etapa-titulo">{guia.suplica.titulo}</h3>
        <Fragment set:html={suplicaP!.html} />
      </div>
    )}

    {guia.final && (
      <div class="etapa" data-guia-etapa={idx('final')}>
        <p class="etapa-sobre">Etapa {idx('final') + 1} de {etapas.length}</p>
        <h3 class="etapa-titulo">{etapas[idx('final')].rotulo}</h3>
        <Fragment set:html={finalP!.html} />
      </div>
    )}

    {guia.ladainha && (
      <div class="etapa" data-guia-etapa={idx('ladainha')}>
        <p class="etapa-sobre">Etapa {idx('ladainha') + 1} de {etapas.length}</p>
        <h3 class="etapa-titulo">{guia.ladainha.titulo}</h3>
        <Fragment set:html={guia.ladainha.html} />
        <p class="guia-nota">A ladainha também tem página própria, com a explicação das invocações: <a href={guia.ladainha.href}>{guia.ladainha.titulo}</a>.</p>
      </div>
    )}

    <div class="etapa" data-guia-etapa={idx('fim')}>
      <p class="etapa-sobre">Etapa {etapas.length} de {etapas.length}</p>
      <h3 class="etapa-titulo" data-guia-fim-titulo>Você terminou o 1º dia</h3>
      <p>Termine com o sinal da cruz:</p>
      <blockquote><p>{SINAL_FINAL}</p></blockquote>
      <p>Marque o dia como rezado para a novena abrir no dia seguinte na sua próxima visita.</p>
      <button type="button" class="btn btn-primario mt-2 w-full" data-guia-marcar aria-pressed="false">Marcar o 1º dia como rezado</button>
      <p class="guia-nota mt-4" data-guia-aviso>O progresso fica salvo neste aparelho. Com login, acompanha você em qualquer aparelho. Veja todas as suas novenas em <a href="/minha-conta">Minha conta</a>.</p>
    </div>
  </div>

  <!-- Barra fixa de navegação entre as etapas -->
  <div class="barra rounded-b-xl border-t border-co-warm-sand-dark bg-white px-3 py-3 md:px-5" data-guia-barra hidden>
    <button type="button" class="btn btn-secundario" data-guia-mover="-1">Anterior</button>
    <p class="barra-meio" data-guia-contador>1 de {etapas.length}</p>
    <button type="button" class="btn btn-primario" data-guia-mover="1"><span data-guia-proximo>Começar</span></button>
  </div>
</section>

<script define:vars={{ id, nome: nomeCurto, rotulos: etapas.map((e) => e.rotulo), iDia: idx('dia') }}>
  window.__novenaGuia = { id, nome, rotulos, iDia };
</script>
<script>
  import { EVENTO, gravar, ler } from '@/lib/progresso';

  const raiz = document.querySelector<HTMLElement>('[data-guia]');
  if (raiz) iniciar(raiz);

  function iniciar(raiz: HTMLElement) {
    const { id, rotulos } = (window as unknown as { __novenaGuia: { id: string; nome: string; rotulos: string[]; iDia: number } }).__novenaGuia;
    const prefixo = `co-novena-${id}-`;
    const hoje = () => new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Sao_Paulo' }).format(new Date());
    const somar = (s: string, n: number) => new Date(Date.parse(`${s}T12:00:00Z`) + n * 86400000).toISOString().slice(0, 10);
    const MESES = ['janeiro', 'fevereiro', 'março', 'abril', 'maio', 'junho', 'julho', 'agosto', 'setembro', 'outubro', 'novembro', 'dezembro'];
    const porExtenso = (s: string) => `${Number(s.slice(8, 10))} de ${MESES[Number(s.slice(5, 7)) - 1]}`;
    const reduzir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const botoesDia = Array.from(raiz.querySelectorAll<HTMLButtonElement>('[data-guia-escolher]'));
    const paineisDia = Array.from(raiz.querySelectorAll<HTMLElement>('[data-guia-dia]'));
    const etapas = Array.from(raiz.querySelectorAll<HTMLElement>('[data-guia-etapa]'));
    const trilha = raiz.querySelector<HTMLElement>('[data-guia-trilha]')!;
    const irBtns = Array.from(raiz.querySelectorAll<HTMLButtonElement>('[data-guia-ir]'));
    const barra = raiz.querySelector<HTMLElement>('[data-guia-barra]')!;
    const [antBtn, proxBtn] = Array.from(raiz.querySelectorAll<HTMLButtonElement>('[data-guia-mover]'));
    const proxTxt = raiz.querySelector<HTMLElement>('[data-guia-proximo]')!;
    const contador = raiz.querySelector<HTMLElement>('[data-guia-contador]')!;
    const marcarBtn = raiz.querySelector<HTMLButtonElement>('[data-guia-marcar]')!;
    const status = raiz.querySelector<HTMLElement>('[data-guia-status]')!;
    const diaTitulo = raiz.querySelector<HTMLElement>('[data-guia-dia-titulo]')!;
    const fimTitulo = raiz.querySelector<HTMLElement>('[data-guia-fim-titulo]')!;
    const palco = raiz.querySelector<HTMLElement>('[data-guia-palco]')!;

    let chave: string | null = null;
    let feitos: boolean[] = Array(9).fill(false);
    let dia = 0;
    let etapa = 0;

    // Com JavaScript: uma etapa por vez, com trilha e barra de navegação
    raiz.classList.add('guia-ativa');
    trilha.hidden = false;
    barra.hidden = false;

    function carregar() {
      const chaves: string[] = [];
      try {
        for (const k of Object.keys(localStorage)) if (k.startsWith(prefixo) && /^\d{4}-\d{2}-\d{2}$/.test(k.slice(prefixo.length))) chaves.push(k);
      } catch {
        /* sem armazenamento */
      }
      chaves.sort().reverse();
      const valores = chaves.map((k) => {
        const v = ler<unknown>(k, null);
        return { k, v: Array.isArray(v) && v.length === 9 ? v.map(Boolean) : Array(9).fill(false) };
      }).filter((x) => x.v.some(Boolean));
      const atual = valores.find((x) => x.v.some((b) => !b)) ?? valores[0];
      chave = atual?.k ?? null;
      feitos = atual?.v ?? Array(9).fill(false);
      const prox = feitos.findIndex((b) => !b);
      dia = prox === -1 ? 8 : prox;
      mostrarDia();
      mostrarEtapa(0, false);
    }

    function mostrarDia() {
      botoesDia.forEach((b, i) => {
        b.setAttribute('aria-pressed', String(i === dia));
        b.classList.toggle('dia-atual', i === dia);
        b.classList.toggle('dia-rezado', feitos[i]);
        b.querySelector('.dia-feito')?.classList.toggle('hidden', !feitos[i]);
        b.querySelector('.dia-feito')?.classList.toggle('flex', feitos[i]);
        b.setAttribute('aria-label', `${i + 1}º dia${feitos[i] ? ', rezado' : ''}`);
      });
      paineisDia.forEach((p, i) => (p.hidden = i !== dia));
      diaTitulo.textContent = `${dia + 1}º dia da novena`;
      fimTitulo.textContent = feitos[dia] ? `${dia + 1}º dia rezado` : `Você terminou o ${dia + 1}º dia`;
      marcarBtn.textContent = feitos[dia] ? `${dia + 1}º dia marcado. Toque para desmarcar` : `Marcar o ${dia + 1}º dia como rezado`;
      marcarBtn.setAttribute('aria-pressed', String(feitos[dia]));
      marcarBtn.classList.toggle('btn-primario', !feitos[dia]);
      marcarBtn.classList.toggle('btn-secundario', feitos[dia]);
      const total = feitos.filter(Boolean).length;
      const inicio = chave?.slice(prefixo.length);
      if (!total) status.textContent = 'Escolha o dia e siga as orações uma de cada vez, na ordem. Ao terminar, marque o dia como rezado.';
      else if (total === 9) status.textContent = 'Você rezou os nove dias desta novena. Para rezar de novo, escolha um dia e desmarque-o no fim.';
      else status.textContent = `Você já rezou ${total} de 9 dias${inicio ? ` (começou em ${porExtenso(inicio)})` : ''}. ${feitos[dia] ? `O ${dia + 1}º dia já está marcado.` : `Agora é o ${dia + 1}º dia.`}`;
    }

    function mostrarEtapa(i: number, rolar = true, direcao = 0) {
      etapa = Math.max(0, Math.min(etapas.length - 1, i));
      etapas.forEach((e, k) => {
        e.hidden = k !== etapa;
        e.classList.remove('entra-dir', 'entra-esq');
        if (k === etapa && direcao && !reduzir) e.classList.add(direcao > 0 ? 'entra-dir' : 'entra-esq');
      });
      irBtns.forEach((b, k) => {
        b.setAttribute('aria-current', k === etapa ? 'step' : 'false');
        b.classList.toggle('feita', k < etapa);
      });
      irBtns[etapa]?.scrollIntoView({ block: 'nearest', inline: 'center', behavior: reduzir ? 'auto' : 'smooth' });
      contador.textContent = `${etapa + 1} de ${etapas.length}`;
      antBtn.disabled = etapa === 0;
      const ultima = etapa === etapas.length - 1;
      proxBtn.hidden = ultima;
      proxTxt.textContent = etapa === 0 ? `Começar o ${dia + 1}º dia` : `Próximo: ${rotulos[etapa + 1] ?? ''}`;
      if (rolar) {
        const topo = trilha.getBoundingClientRect().top;
        if (topo < 0 || topo > window.innerHeight * 0.4) trilha.scrollIntoView({ block: 'start', behavior: reduzir ? 'auto' : 'smooth' });
      }
    }

    botoesDia.forEach((b, i) => b.addEventListener('click', () => {
      dia = i;
      mostrarDia();
      mostrarEtapa(etapa === etapas.length - 1 ? 0 : etapa, false);
    }));
    irBtns.forEach((b, i) => b.addEventListener('click', () => mostrarEtapa(i, true, i > etapa ? 1 : -1)));
    antBtn.addEventListener('click', () => mostrarEtapa(etapa - 1, true, -1));
    proxBtn.addEventListener('click', () => mostrarEtapa(etapa + 1, true, 1));

    // Deslizar para o lado no celular
    let x0 = 0;
    let y0 = 0;
    palco.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
    palco.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - x0;
      const dy = e.changedTouches[0].clientY - y0;
      if (Math.abs(dx) > 70 && Math.abs(dx) > Math.abs(dy) * 1.5) mostrarEtapa(etapa + (dx < 0 ? 1 : -1), true, dx < 0 ? 1 : -1);
    }, { passive: true });
    // Setas do teclado quando o foco está no roteiro
    raiz.addEventListener('keydown', (e) => {
      const alvo = e.target as HTMLElement;
      if (alvo.closest('input, textarea, summary')) return;
      if (e.key === 'ArrowRight') mostrarEtapa(etapa + 1, true, 1);
      if (e.key === 'ArrowLeft') mostrarEtapa(etapa - 1, true, -1);
    });

    marcarBtn.addEventListener('click', () => {
      // novena nova: o 1º dia é contado a partir de hoje
      if (!chave) {
        chave = `${prefixo}${somar(hoje(), -dia)}`;
        feitos = Array(9).fill(false);
      }
      feitos = feitos.map((x, k) => (k === dia ? !x : x));
      gravar(chave, feitos);
      if (feitos[dia]) {
        try {
          (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag?.('event', 'novena_dia', { novena: id, dia: dia + 1 });
        } catch {
          /* sem GA */
        }
      }
      mostrarDia();
      if (feitos[dia] && dia < 8 && !feitos[dia + 1]) status.textContent += ` Na próxima visita, a novena abre no ${dia + 2}º dia.`;
    });
    addEventListener(EVENTO, carregar);
    carregar();
  }
</script>

<style>
  .guia-novena .dia-atual { background: hsl(var(--co-warm-terracotta)); border-color: hsl(var(--co-warm-terracotta)); color: #fff; }
  .guia-novena .dia-atual .dia-feito { background: #fff; color: hsl(var(--co-warm-terracotta)); }
  .guia-novena .dia-rezado:not(.dia-atual) { background: hsl(var(--co-warm-cream)); }

  /* Trilha das etapas */
  .trilha { overflow-x: auto; scrollbar-width: none; background: #fff; }
  .trilha::-webkit-scrollbar { display: none; }
  .trilha ol { display: flex; gap: 0.25rem; margin: 0; padding: 0.6rem 0.75rem; list-style: none; min-width: max-content; }
  .trilha button {
    display: inline-flex; align-items: center; gap: 0.45rem; min-height: 2.5rem; padding: 0 0.75rem; border-radius: 999px;
    font-size: 14px; font-weight: 500; color: hsl(var(--co-warm-brown) / 0.75); white-space: nowrap;
  }
  .trilha button:hover { color: hsl(var(--co-warm-brown)); background: hsl(var(--co-warm-cream)); }
  .trilha button:focus-visible { outline: 2px solid hsl(var(--co-warm-terracotta)); outline-offset: 2px; }
  .trilha-num {
    display: inline-flex; align-items: center; justify-content: center; width: 1.5rem; height: 1.5rem; border-radius: 999px;
    border: 1.5px solid currentColor; font-size: 12px; font-weight: 700;
  }
  .trilha button.feita { color: hsl(var(--co-warm-brown)); }
  .trilha button.feita .trilha-num { background: hsl(var(--co-warm-brown)); border-color: hsl(var(--co-warm-brown)); color: #fff; }
  .trilha button[aria-current='step'] { background: hsl(var(--co-warm-terracotta)); color: #fff; font-weight: 700; }
  .trilha button[aria-current='step'] .trilha-num { border-color: #fff; }

  /* Etapas: sem JavaScript, todas aparecem em sequência; com ele, uma por vez */
  .guia-novena :global(.etapa + .etapa) { margin-top: 2rem; padding-top: 2rem; border-top: 1px solid hsl(var(--co-warm-sand-dark)); }
  .guia-ativa :global(.etapa + .etapa) { margin-top: 0; padding-top: 0; border-top: 0; }
  .guia-novena :global(.etapa-sobre) { margin: 0 0 0.25rem; font-size: 14px; font-weight: 600; color: hsl(var(--co-warm-terracotta)); text-align: left; }
  .guia-novena :global(.etapa-titulo) {
    margin: 0 0 1rem; font-family: 'Source Serif 4 Variable', 'Source Serif 4', Georgia, serif; font-weight: 600;
    font-size: calc(1.45rem * var(--prose-escala, 1)); line-height: 1.3; color: hsl(var(--co-warm-brown));
  }
  .guia-novena :global(.etapa p) { text-align: left; }
