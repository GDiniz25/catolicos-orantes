---
/** Retrato redondo do santo: a imagem do artigo dele, ou a inicial do nome quando ainda não há imagem. */
import { getShortName } from '@/lib/saints';
import { imagemResponsiva } from '@/lib/imagens';
interface Props {
  nome: string;
  imagem?: string | null;
  class?: string;
  /** classe do tamanho da letra quando não há imagem */
  letra?: string;
}
const { nome, imagem, class: cls = 'h-16 w-16', letra = 'text-3xl' } = Astro.props;
const img = imagem ? await imagemResponsiva(imagem, 240, false, 240) : null;
const inicial = (getShortName(nome).replace(/^(São|Santa|Santo|S\.|Sto\.|Sta\.|Beato|Beata|Bem-aventurad[oa]|Nossa Senhora d[aeo]s?)\s*/i, '').trim()[0] || '+').toUpperCase();
---
{img ? (
  <img src={img.src} srcset={img.srcset} sizes={img.srcset ? '64px' : undefined} width="64" height="64" alt="" loading="lazy" decoding="async" class:list={['shrink-0 rounded-full border-2 border-[#D9BE78] bg-[#F7F0DC] object-cover object-[center_20%]', cls]} />
) : (
  <span class:list={['flex shrink-0 items-center justify-center rounded-full border-2 border-[#D9BE78] bg-[#F7F0DC] font-display font-semibold text-[#7A5820]', cls, letra]} aria-hidden="true">{inicial}</span>
)}
