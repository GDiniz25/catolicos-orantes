---
/**
 * Terço do dia: os mistérios de cada dia da semana, com seletor.
 * Todos os mistérios estão no HTML (bom para busca e para quem está sem JavaScript).
 */
import { getTodayStr, parseDate, WEEKDAYS_SHORT, WEEKDAYS_FULL } from '@/lib/dateUtils';
import { MISTERIOS, MISTERIO_DA_SEMANA, type Misterio } from '@/lib/anoLiturgico';

const hoje = parseDate(getTodayStr()).getDay();
const cores: Record<Misterio, string> = { gozosos: '#7A5820', dolorosos: '#5A3F6B', gloriosos: '#8F3E26', luminosos: '#2C5679' };
const lista = Object.entries(MISTERIOS) as [Misterio, (typeof MISTERIOS)[Misterio]][];
---
<div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-12" data-terco>
  <div>
    <h2 id="terco-titulo" class="font-display text-3xl font-semibold leading-tight md:text-4xl" data-terco-titulo>{MISTERIOS[MISTERIO_DA_SEMANA[hoje]].nome}</h2>
    <p class="mt-3 text-[17px] leading-relaxed text-co-warm-brown/80">
      <span data-terco-dia>{WEEKDAYS_FULL[hoje]}</span> é dia de meditar estes mistérios. Escolha outro dia para ver os demais.
    </p>
    <div class="mt-5 grid grid-cols-7 gap-1.5" role="group" aria-label="Dia da semana">
      {WEEKDAYS_SHORT.map((d, i) => (
        <button
          type="button"
          data-dia={i}
          aria-label={WEEKDAYS_FULL[i]}
          aria-pressed={i === hoje ? 'true' : 'false'}
          class="h-11 w-full min-w-0 rounded-md border border-co-warm-sand-dark bg-white text-sm font-semibold text-co-warm-brown transition-colors hover:border-co-warm-brown/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-co-warm-terracotta aria-pressed:border-co-warm-brown aria-pressed:bg-co-warm-brown aria-pressed:text-white"
        >{d}</button>
      ))}
    </div>
    <div class="acoes mt-6">
      <a href="/terco-guiado" class="btn btn-primario">Rezar o terço guiado</a>
      <a href="/como-rezar-o-terco" class="btn btn-secundario">Como rezar o terço</a>
    </div>
  </div>

  {lista.map(([id, m]) => (
    <ol class="grid content-start gap-3" data-misterio={id} hidden={id !== MISTERIO_DA_SEMANA[hoje]} aria-label={m.nome}>
      {m.itens.map((t, i) => (
        <li class="flex items-center gap-4 border-l-[3px] bg-white/60 py-3 pl-4 pr-3" style={`border-color:${cores[id]}`}>
          <span class="w-10 shrink-0 font-display text-3xl font-semibold leading-none" style={`color:${cores[id]}`}>{i + 1}º</span>
          <span class="block font-display text-lg font-semibold leading-snug text-co-warm-brown">{t}</span>
        </li>
      ))}
    </ol>
  ))}
</div>

<script>
  import { MISTERIOS, MISTERIO_DA_SEMANA, hojeBrasilia } from '@/lib/anoLiturgico';
  const DIAS = ['Domingo', 'Segunda-feira', 'Terça-feira', 'Quarta-feira', 'Quinta-feira', 'Sexta-feira', 'Sábado'];
  document.querySelectorAll<HTMLElement>('[data-terco]').forEach((el) => {
    const botoes = Array.from(el.querySelectorAll<HTMLButtonElement>('[data-dia]'));
    const listas = Array.from(el.querySelectorAll<HTMLElement>('[data-misterio]'));
    const mostrar = (dia: number) => {
      const m = MISTERIO_DA_SEMANA[dia];
      botoes.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.dia) === dia)));
      listas.forEach((l) => (l.hidden = l.dataset.misterio !== m));
      el.querySelector('[data-terco-titulo]')!.textContent = MISTERIOS[m].nome;
      el.querySelector('[data-terco-dia]')!.textContent = DIAS[dia];
    };
    const [y, mo, d] = hojeBrasilia().split('-').map(Number);
    mostrar(new Date(y, mo - 1, d).getDay());
    botoes.forEach((b) => b.addEventListener('click', () => mostrar(Number(b.dataset.dia))));
  });
</script>
