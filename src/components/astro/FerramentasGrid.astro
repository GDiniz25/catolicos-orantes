---
import { FERRAMENTAS, type Ferramenta } from '@/data/ferramentas';
interface Props { itens?: Ferramenta[] }
const { itens = FERRAMENTAS } = Astro.props;
const COR = { rezar: { tinta: '#8F3E26', fundo: '#F6E7E1' }, conhecer: { tinta: '#7A5820', fundo: '#F5ECD8' }, aprender: { tinta: '#2E4A66', fundo: '#E4ECF3' } };
---
<ul class="gs gs-x2 gs-lg3 gap-3">
  {itens.map((f) => {
    const Icon = f.icon;
    const c = COR[f.grupo];
    return (
      <li>
        <a href={f.href} class="group flex h-full items-start gap-3.5 rounded-lg border border-co-warm-sand-dark bg-white p-4 transition-colors hover:border-co-warm-brown/35 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-co-warm-terracotta md:p-5">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-md" style={`background:${c.fundo};color:${c.tinta}`}><Icon className="h-[22px] w-[22px]" strokeWidth={1.8} aria-hidden="true" /></span>
          <span class="min-w-0"><span class="block font-display text-lg font-semibold leading-snug group-hover:text-co-warm-terracotta">{f.titulo}</span><span class="mt-1 block text-sm leading-snug text-co-warm-brown/80">{f.descricao}</span></span>
        </a>
      </li>
    );
  })}
</ul>
