---
import { Moon } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import DiaAtual from '@/components/astro/DiaAtual.astro';
import PageHeader from '@/components/astro/PageHeader.astro';
import HojeNav from '@/components/astro/HojeNav.astro';
import { CATEGORY_VISUAL } from '@/config/categoryVisual';
import { getLiturgia } from '@/lib/data';
import { celebracaoDaLiturgia, infoDoDia } from '@/lib/anoLiturgico';
import { getTodayStr, offsetDate } from '@/lib/dateUtils';
import { dataComSemana, dataBarra } from '@/lib/hoje';
import { oficioDoDia, grauDaCelebracao, ROMANO, NUNC_DIMITTIS, COMPLETAS, type OficioDoDia } from '@/lib/salterio';
import { absUrl, breadcrumbSchema, clampText, faqSchema, publisherRef } from '@/lib/seo';

const hoje = getTodayStr();
// 9 dias: o último serve só para saber se o 8º dia é véspera de solenidade
const dias = await Promise.all(
  Array.from({ length: 9 }, (_, i) => offsetDate(hoje, i)).map(async (data) => {
    const lit = await getLiturgia(data);
    const celebracao = celebracaoDaLiturgia(lit);
    return { data, celebracao, oficio: oficioDoDia(data, grauDaCelebracao(celebracao)) };
  }),
);

const maiuscula = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const semGrau = (c: string) => c.replace(/,\s*Solenidade$/i, '').trim();

/** Salmos das Completas de um dia. Na véspera de uma solenidade, depois das I Vésperas, rezam-se as Completas do sábado. */
const completasDe = (i: number): { salmos: string[]; nota: string | null } => {
  const atual = dias[i];
  const prox = dias[i + 1];
  if (prox && atual.oficio.grau !== 'solenidade' && prox.oficio.grau === 'solenidade' && prox.celebracao && atual.oficio.diaSemana !== 6) {
    return { salmos: COMPLETAS[6], nota: `Amanhã é solenidade: ${semGrau(prox.celebracao)}. Depois das I Vésperas, rezam-se as Completas do sábado.` };
  }
  return { salmos: atual.oficio.completas, nota: atual.oficio.completasNota ?? null };
};

const dia = dias[0];
const o: OficioDoDia = dia.oficio;
const c = completasDe(0);
const proximos = dias.slice(1, 8).map((p, k) => ({ ...p, c: completasDe(k + 1) }));
const pascal = infoDoDia(hoje).tempo.id === 'pas';

const dataExtenso = maiuscula(dataComSemana(hoje));
const semanaTxt = o.semana ? `Semana ${ROMANO[o.semana]} do saltério` : 'Ofício próprio do dia';
const nomeDia = dia.celebracao ?? o.rotulo;
const salmosTxt = c.salmos.join(' e ');
const umSalmo = c.salmos.length === 1;

const title = `Completas de hoje, ${dataBarra(hoje)}: oração antes de dormir`;
const description = clampText(`Completas de hoje, ${dataComSemana(hoje)}: ${umSalmo ? 'o salmo' : 'os salmos'} da oração da noite, exame de consciência, Nunc dimittis e antífona de Nossa Senhora.`);
const path = '/completas-de-hoje';
const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Liturgia das Horas', path: '/liturgia-das-horas' },
  { name: 'Completas de hoje', path },
];
const faq = [
  {
    q: 'Quais são os salmos das Completas de hoje?',
    a: `Hoje, ${dataComSemana(hoje)}, as Completas têm ${umSalmo ? 'o' : 'os'} ${salmosTxt}.${c.nota ? ` ${c.nota}` : ''} Depois da leitura breve vem o ${NUNC_DIMITTIS}.`,
  },
  { q: 'Que horas se rezam as Completas?', a: 'As Completas são a última oração do dia. Rezam-se antes de dormir, mesmo que já passe da meia-noite. Quem rezou as Vésperas reza as Completas mais tarde, já perto de deitar.' },
  { q: 'Leigos podem rezar as Completas?', a: 'Sim. As Completas são curtas e simples, por isso são uma ótima porta de entrada na Liturgia das Horas. Podem ser rezadas sozinho, em casal ou em família.' },
];
const jsonLd = [
  {
    '@type': 'Article',
    '@id': `${absUrl(path)}#article`,
    headline: `Completas de hoje: ${dataExtenso}`,
    description,
    datePublished: `${hoje}T00:00:00-03:00`,
    dateModified: `${hoje}T00:00:00-03:00`,
    inLanguage: 'pt-BR',
    image: [absUrl('/og-image.png')],
    author: { '@type': 'Organization', name: 'Católicos Orantes', url: absUrl('/') },
    publisher: publisherRef,
    mainEntityOfPage: { '@type': 'WebPage', '@id': absUrl(path) },
  },
  breadcrumbSchema(crumbs),
  faqSchema(faq),
];
const curto = (d: string) => maiuscula(dataComSemana(d).replace(/ de \d{4}$/, ''));
const leituras = [
  { href: '/liturgia-das-horas/completas-oracao-antes-de-dormir', t: 'Completas: a oração antes de dormir' },
  { href: '/liturgia-das-horas/vesperas-oracao-da-tarde', t: 'Vésperas: como rezar a oração da tarde da Igreja' },
  { href: '/liturgia-das-horas/introducao-a-liturgia-das-horas-para-leigos', t: 'Introdução à Liturgia das Horas para leigos' },
  { href: '/exame-de-consciencia', t: 'Exame de consciência completo' },
];
const exame = [
  'Onde Deus esteve presente no meu dia? Agradeço por isso.',
  'Rezei, ou deixei Deus de lado?',
  'Como tratei as pessoas da minha casa e do meu trabalho?',
  'Falei mal de alguém, menti ou fui impaciente?',
  'Deixei de fazer algum bem que podia ter feito?',
];
const nunc = [
  'Deixai, agora, vosso servo ir em paz, conforme prometestes, ó Senhor.',
  'Pois meus olhos viram vossa salvação, que preparastes ante a face das nações:',
  'uma luz que brilhará para os gentios e para a glória de Israel, o vosso povo.',
];
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  keywords="completas de hoje, completas, oração da noite, oração antes de dormir, liturgia das horas hoje, nunc dimittis, salmo das completas, exame de consciência"
  ogType="article"
  jsonLd={jsonLd}
>
  <DiaAtual tipo="completas" />
  <PageHeader title="Completas de hoje" subtitle={`${dataExtenso}. A oração da noite da Igreja: ${umSalmo ? 'o salmo' : 'os salmos'} de hoje, o Nunc dimittis e o roteiro para rezar antes de dormir.`} icon={Moon} crumbs={crumbs} tom={CATEGORY_VISUAL['liturgia-das-horas']} />
  <main id="conteudo" class="py-8 md:py-12">
    <div class="container mx-auto max-w-3xl space-y-12 px-4">

      <section aria-labelledby="hoje" class="rounded-2xl border border-co-warm-sand-dark bg-white p-5 md:p-7">
        <div class="flex items-start gap-4 sm:gap-5">
          <div class="grid h-20 w-20 shrink-0 place-items-center rounded-xl text-center" style={`background:${CATEGORY_VISUAL['liturgia-das-horas'].fundo};color:${CATEGORY_VISUAL['liturgia-das-horas'].tinta}`}>
            {o.semana ? (
              <span><span class="block font-display text-3xl font-semibold leading-none">{ROMANO[o.semana]}</span><span class="mt-1 block text-[12px] font-semibold">semana</span></span>
            ) : (
              <span class="px-1 text-[13px] font-semibold leading-tight">Ofício próprio</span>
            )}
          </div>
          <div class="min-w-0">
            <h2 id="hoje" class="font-display text-2xl font-semibold leading-tight">{nomeDia}</h2>
            <p class="mt-1 text-[15px] text-co-warm-brown/80">{dataExtenso}{dia.celebracao && o.rotulo !== dia.celebracao ? `. ${o.rotulo}` : ''}</p>
            <p class="mt-3 text-[16px] leading-relaxed">
              As Completas seguem um ciclo de uma semana. Hoje {umSalmo ? 'o salmo é o' : 'os salmos são o'} <strong>{salmosTxt}</strong>.
            </p>
            {c.nota && <p class="nota">{c.nota}</p>}
          </div>
        </div>
        <div class="acoes-2 mt-5">
          <a href="#salmodia" class="btn btn-primario">{umSalmo ? 'Salmo de hoje' : 'Salmos de hoje'}</a>
          <a href="#roteiro" class="btn btn-secundario">Como rezar</a>
        </div>
      </section>

      <section aria-labelledby="salmodia" class="scroll-mt-24">
        <h2 id="salmodia" class="font-display text-2xl font-semibold md:text-3xl">{umSalmo ? 'Salmo das Completas de hoje' : 'Salmos das Completas de hoje'}</h2>
        <p class="mt-3 text-[17px] leading-relaxed">{semanaTxt}. O salmo das Completas não muda com a semana do saltério: depende só do dia da semana.</p>
        <ul class="salmos mt-4">{c.salmos.map((s) => <li>{s}</li>)}</ul>
        {c.nota && <p class="nota">{c.nota}</p>}
        <p class="mt-4 text-[17px] leading-relaxed">Depois da leitura breve, reza-se o <strong>{NUNC_DIMITTIS}</strong>. Ele é o mesmo todas as noites.</p>
      </section>

      <section aria-labelledby="roteiro" class="scroll-mt-24">
        <h2 id="roteiro" class="font-display text-2xl font-semibold md:text-3xl">Roteiro para rezar as Completas</h2>
        <ol class="roteiro mt-5">
          <li><strong>Abertura.</strong> Faz-se o sinal da cruz e reza-se: <em>Vinde, ó Deus, em meu auxílio. Socorrei-me sem demora.</em> Segue o Glória ao Pai.</li>
          <li><strong>Exame de consciência</strong> em silêncio, seguido do ato penitencial. Veja abaixo.</li>
          <li><strong>Hino</strong> da noite.</li>
          <li>
            <strong>Salmodia de hoje</strong>, com antífona e o Glória ao Pai no fim:
            <ul class="salmos">{c.salmos.map((s) => <li>{s}</li>)}</ul>
          </li>
          <li><strong>Leitura breve</strong> e responsório: <em>Senhor, em vossas mãos eu entrego o meu espírito.</em></li>
          <li><strong>Nunc dimittis</strong>, com a antífona: <em>Salvai-nos, Senhor, quando velamos, guardai-nos também quando dormimos! Nossa mente vigie com o Cristo, nosso corpo repouse em sua paz!</em></li>
          <li><strong>Oração</strong> do dia e bênção: <em>O Senhor todo-poderoso nos conceda uma noite tranquila e, no fim da vida, uma morte santa. Amém.</em></li>
          <li><strong>Antífona de Nossa Senhora</strong>, a última oração antes de dormir.</li>
        </ol>
      </section>

      <section aria-labelledby="exame" class="scroll-mt-24 rounded-2xl border border-co-warm-sand-dark bg-white p-5 md:p-7">
        <h2 id="exame" class="font-display text-2xl font-semibold md:text-3xl">Exame de consciência breve</h2>
        <p class="mt-3 text-[17px] leading-relaxed">Faça um minuto de silêncio. Olhe para o dia com calma, diante de Deus.</p>
        <ul class="perguntas mt-4">{exame.map((p) => <li>{p}</li>)}</ul>
        <h3 class="mt-6 font-display text-xl font-semibold">Ato penitencial</h3>
        <p class="mt-2 text-[17px] leading-relaxed"><em>Confesso a Deus todo-poderoso e a vós, irmãos e irmãs, que pequei muitas vezes por pensamentos e palavras, atos e omissões, por minha culpa, minha culpa, minha tão grande culpa. E peço à Virgem Maria, aos anjos e santos e a vós, irmãos e irmãs, que rogueis por mim a Deus, nosso Senhor.</em></p>
        <p class="mt-3 text-[17px] leading-relaxed"><em>Deus todo-poderoso tenha compaixão de nós, perdoe os nossos pecados e nos conduza à vida eterna. Amém.</em></p>
        <div class="acoes mt-5">
          <a href="/exame-de-consciencia" class="btn btn-secundario">Exame de consciência completo</a>
        </div>
      </section>

      <section aria-labelledby="nunc" class="scroll-mt-24 rounded-2xl border border-co-warm-sand-dark bg-co-warm-cream/60 p-5 md:p-7">
        <h2 id="nunc" class="font-display text-2xl font-semibold md:text-3xl">Nunc dimittis: o cântico de Simeão</h2>
        <p class="mt-2 text-[15px] text-co-warm-brown/80">Lc 2,29-32. Rezado todas as noites nas Completas.</p>
        <div class="cantico mt-4">
          {nunc.map((linha) => <p>{linha}</p>)}
          <p class="mt-3"><em>Glória ao Pai e ao Filho e ao Espírito Santo. Como era no princípio, agora e sempre. Amém.</em></p>
        </div>
      </section>

      <section aria-labelledby="mariana" class="scroll-mt-24">
        <h2 id="mariana" class="font-display text-2xl font-semibold md:text-3xl">Antífona final de Nossa Senhora</h2>
        {pascal ? (
          <>
            <p class="mt-3 text-[17px] leading-relaxed">No Tempo Pascal, as Completas terminam com a <strong>Rainha do céu</strong> (Regina caeli).</p>
            <div class="cantico mt-4">
              <p><em>Rainha do céu, alegrai-vos, aleluia!</em></p>
              <p><em>Porque quem merecestes trazer em vosso seio, aleluia,</em></p>
              <p><em>ressuscitou como disse, aleluia!</em></p>
              <p><em>Rogai a Deus por nós, aleluia!</em></p>
            </div>
          </>
        ) : (
          <>
            <p class="mt-3 text-[17px] leading-relaxed">As Completas terminam com uma antífona a Nossa Senhora. A mais conhecida é a <a href="/oracoes-do-dia-a-dia/a-salve-rainha-historia-e-significado" class="font-semibold text-co-warm-terracotta underline underline-offset-4">Salve-Rainha</a>.</p>
            <div class="cantico mt-4">
              <p><em>Salve, Rainha, Mãe de misericórdia, vida, doçura e esperança nossa, salve!</em></p>
              <p><em>A vós bradamos, os degredados filhos de Eva. A vós suspiramos, gemendo e chorando neste vale de lágrimas.</em></p>
              <p><em>Eia, pois, advogada nossa, esses vossos olhos misericordiosos a nós volvei.</em></p>
              <p><em>E depois deste desterro, mostrai-nos Jesus, bendito fruto do vosso ventre.</em></p>
              <p><em>Ó clemente, ó piedosa, ó doce sempre Virgem Maria.</em></p>
            </div>
          </>
        )}
      </section>

      <section aria-labelledby="semana" class="border-t border-co-warm-sand-dark pt-8">
        <h2 id="semana" class="font-display text-2xl font-semibold md:text-3xl">Completas dos próximos dias</h2>
        <ul class="mt-5 divide-y divide-co-warm-sand-dark border-y border-co-warm-sand-dark">
          {proximos.map((p) => (
            <li class="py-3">
              <p class="flex flex-wrap items-baseline justify-between gap-x-3">
                <span class="font-semibold">{curto(p.data)}</span>
                <span class="text-sm text-co-warm-brown/75">{p.oficio.semana ? `Semana ${ROMANO[p.oficio.semana]}` : 'Ofício próprio'}</span>
              </p>
              <p class="text-sm text-co-warm-brown/80">{p.celebracao ?? p.oficio.rotulo}</p>
              <p class="mt-1 text-[15px]">{p.c.salmos.join('; ')}</p>
              {p.c.nota && <p class="text-sm text-co-warm-brown/75">{p.c.nota}</p>}
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="outras-horas">
        <h2 id="outras-horas" class="font-display text-2xl font-semibold md:text-3xl">As outras horas de hoje</h2>
        <p class="mt-3 text-[17px] leading-relaxed">As Laudes santificam a manhã. As Vésperas, o fim da tarde. As Completas fecham o dia.</p>
        <div class="acoes mt-5">
          <a href="/vesperas-de-hoje" class="btn btn-primario">Vésperas de hoje</a>
          <a href="/laudes-de-hoje" class="btn btn-secundario">Laudes de hoje</a>
        </div>
      </section>

      <section aria-labelledby="perguntas">
        <h2 id="perguntas" class="font-display text-2xl font-semibold md:text-3xl">Perguntas frequentes</h2>
        <div class="mt-4 space-y-5">
          {faq.map((f) => (<div><h3 class="font-display text-xl font-semibold">{f.q}</h3><p class="mt-1 text-[16px] leading-relaxed">{f.a}</p></div>))}
        </div>
      </section>

      <section aria-labelledby="aprofundar" class="rounded-2xl border border-co-warm-sand-dark bg-co-warm-cream/60 p-5 md:p-7">
        <h2 id="aprofundar" class="font-display text-2xl font-semibold">Para aprofundar</h2>
        <ul class="mt-4 space-y-2">
          {leituras.map((l) => <li><a href={l.href} class="font-semibold text-co-warm-terracotta underline-offset-4 hover:underline">{l.t}</a></li>)}
        </ul>
      </section>

      <HojeNav atual="completas" />
    </div>
  </main>
</BaseLayout>

<style>
  .roteiro { counter-reset: passo; display: grid; gap: 0.9rem; }
  .roteiro > li { counter-increment: passo; position: relative; padding-left: 2.4rem; font-size: 17px; line-height: 1.65; overflow-wrap: anywhere; }
  .roteiro > li::before { content: counter(passo); position: absolute; left: 0; top: 0.1rem; display: grid; place-items: center; width: 1.7rem; height: 1.7rem; border-radius: 999px; background: hsl(var(--co-warm-cream)); font-size: 14px; font-weight: 700; }
  .salmos { margin-top: 0.5rem; display: grid; gap: 0.35rem; }
  .salmos > li { border-left: 3px solid hsl(var(--co-warm-forest)); padding-left: 0.75rem; font-weight: 600; }
  .nota { margin-top: 0.5rem; font-size: 15px; color: hsl(var(--co-warm-brown) / 0.8); }
  .cantico { display: grid; gap: 0.4rem; font-size: 17px; line-height: 1.65; }
  .perguntas { display: grid; gap: 0.5rem; font-size: 17px; line-height: 1.6; }
  .perguntas > li { position: relative; padding-left: 1.25rem; }
  .perguntas > li::before { content: ''; position: absolute; left: 0.2rem; top: 0.7rem; width: 0.4rem; height: 0.4rem; border-radius: 999px; background: hsl(var(--co-warm-terracotta)); }
</style>
