---
import { CalendarDays } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/astro/PageHeader.astro';
import Faq from '@/components/astro/Faq.astro';
import TabelaDatas from '@/components/astro/TabelaDatas.astro';
import { ANOS_DATAS, datasDoAno, dataPorExtenso, ciclos } from '@/lib/datasLiturgicas';
import { CATEGORY_VISUAL } from '@/config/categoryVisual';
import { absUrl, breadcrumbSchema, faqSchema } from '@/lib/seo';

export function getStaticPaths() {
  return ANOS_DATAS.map((ano) => ({ params: { ano: String(ano) }, props: { ano } }));
}
const { ano } = Astro.props as { ano: number };
const path = `/datas-liturgicas/${ano}`;
const d = Object.fromEntries(datasDoAno(ano).map((x) => [x.id, x.data]));
const ext = (id: string) => dataPorExtenso(d[id]);
const antes = ciclos(ano - 1);
const depois = ciclos(ano);
const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Datas litúrgicas', path: '/datas-liturgicas' },
  { name: String(ano), path },
];
const FAQ = [
  { q: `Quando é a Páscoa em ${ano}?`, a: `Em ${ano}, o Domingo de Páscoa cai em ${ext('pascoa')}. A Páscoa é o primeiro domingo depois da primeira lua cheia que ocorre a partir do equinócio de março, segundo o cálculo eclesiástico.` },
  { q: `Quando é o Carnaval e a Quarta-feira de Cinzas em ${ano}?`, a: `A terça-feira de Carnaval é em ${ext('carnaval')} e a Quarta-feira de Cinzas, que abre a Quaresma, em ${ext('cinzas')}.` },
  { q: `Quando é Corpus Christi em ${ano}?`, a: `Corpus Christi é em ${ext('corpus-christi')}, sessenta dias depois da Páscoa.` },
  { q: `Qual é o ano litúrgico de ${ano}?`, a: `Até o sábado antes do Advento, os domingos seguem o Ano ${antes.domingos} e os dias de semana o ano ${antes.semana === 'I' ? 'ímpar' : 'par'}. A partir do 1º Domingo do Advento (${ext('advento')}), começa o Ano ${depois.domingos}.` },
];
const jsonLd = [
  { '@type': 'WebPage', '@id': `${absUrl(path)}#webpage`, url: absUrl(path), name: `Datas litúrgicas de ${ano}: Páscoa, Quaresma, Corpus Christi e mais`, inLanguage: 'pt-BR' },
  faqSchema(FAQ),
  breadcrumbSchema(crumbs),
];
---
<BaseLayout
  title={`Calendário litúrgico ${ano}: Páscoa, Cinzas e Corpus Christi`}
  description={`Datas da Igreja Católica em ${ano}: Páscoa em ${ext('pascoa')}, Cinzas em ${ext('cinzas')}, Corpus Christi, Pentecostes, Advento e outras festas.`.slice(0, 158)}
  path={path}
  keywords={`páscoa ${ano}, quando é a páscoa ${ano}, carnaval ${ano}, quarta-feira de cinzas ${ano}, corpus christi ${ano}, calendário litúrgico ${ano}`}
  jsonLd={jsonLd}
>
  <PageHeader title={`Datas litúrgicas de ${ano}`} subtitle={`Em ${ano}, a Páscoa é no ${ext('pascoa')}. Veja todas as celebrações móveis e fixas do ano, calculadas pelas regras da Igreja no Brasil.`} icon={CalendarDays} crumbs={crumbs} tom={CATEGORY_VISUAL['calendario-liturgico']}>
    <nav class="mt-6" aria-label="Outros anos">
      <ol class="grid max-w-xl grid-cols-7 gap-1.5 sm:gap-2">
        {ANOS_DATAS.map((a) => (
          <li><a href={`/datas-liturgicas/${a}`} aria-current={a === ano ? 'page' : undefined} class:list={['flex h-10 w-full items-center justify-center rounded-full border px-0 text-[13px] font-semibold sm:text-sm', a === ano ? 'border-co-warm-brown bg-co-warm-brown text-white' : 'border-co-warm-sand-dark bg-white hover:border-co-warm-brown/40']}>{a}</a></li>
        ))}
      </ol>
    </nav>
  </PageHeader>
  <main id="conteudo" class="py-8 md:py-12">
    <div class="container mx-auto grid max-w-5xl gap-10 px-4 lg:grid-cols-[minmax(0,1fr)_260px]">
      <div class="min-w-0 space-y-10">
        <div class="grid gap-3 sm:grid-cols-3">
          {[['pascoa', 'Páscoa'], ['cinzas', 'Cinzas'], ['corpus-christi', 'Corpus Christi']].map(([id, nome]) => (
            <div class="rounded-xl border border-co-warm-sand-dark bg-white p-4">
              <p class="text-sm font-semibold text-[#36613F]">{nome}</p>
              <p class="mt-1 font-display text-xl font-semibold">{dataPorExtenso(d[id], false)}</p>
              <p class="text-sm text-co-warm-brown/75">{dataPorExtenso(d[id]).split(',')[0]}</p>
            </div>
          ))}
        </div>
        <section aria-labelledby="todas">
          <h2 id="todas" class="mb-4 font-display text-2xl font-semibold">Todas as datas de {ano}</h2>
          <TabelaDatas ano={ano} />
        </section>
        <section class="intro-prose max-w-2xl text-[17px]" aria-labelledby="como">
          <h2 id="como" class="font-display text-2xl font-semibold">Como as datas são calculadas?</h2>
          <p>A Páscoa é celebrada no primeiro domingo depois da primeira lua cheia que acontece a partir de 21 de março, segundo o cálculo eclesiástico fixado desde os primeiros séculos. Dela dependem as outras datas móveis: a Quarta-feira de Cinzas vem 46 dias antes, Pentecostes 49 dias depois e Corpus Christi 60 dias depois.</p>
          <p>O Advento começa no quarto domingo antes do Natal. No Brasil, a Epifania é celebrada no domingo entre 2 e 8 de janeiro e a Ascensão no 7º Domingo da Páscoa.</p>
        </section>
        <Faq title="Perguntas frequentes" items={FAQ} />
      </div>
      <aside class="space-y-4">
        <div class="rounded-xl border border-co-warm-sand-dark bg-co-warm-cream p-5 text-[15px]">
          <p class="font-semibold">Ciclo de leituras</p>
          <p class="mt-2">Até o Advento: <strong>Ano {antes.domingos}</strong> nos domingos, ano {antes.semana === 'I' ? 'ímpar' : 'par'} nos dias de semana.</p>
          <p class="mt-2">Depois do Advento: <strong>Ano {depois.domingos}</strong>, ano {depois.semana === 'I' ? 'ímpar' : 'par'}.</p>
          <a href="/duvidas-da-fe/o-que-sao-os-anos-a-b-e-c-no-ciclo-liturgico-catolico" class="mt-3 inline-block font-semibold text-co-warm-terracotta underline-offset-4 hover:underline">O que são os anos A, B e C</a>
        </div>
        <a href="/planejador-de-novena" class="block rounded-xl border border-co-warm-sand-dark bg-white p-5 hover:border-co-warm-brown/35">
          <span class="font-semibold">Planejador de novena</span>
          <span class="mt-1 block text-sm text-co-warm-brown/80">Saiba quando começar cada novena para terminar no dia da festa.</span>
        </a>
      </aside>
    </div>
  </main>
</BaseLayout>
