---
import { Wrench } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/astro/PageHeader.astro';
import FerramentasGrid from '@/components/astro/FerramentasGrid.astro';
import { FERRAMENTAS, GRUPOS_FERRAMENTAS } from '@/data/ferramentas';
import { absUrl, breadcrumbSchema, itemListSchema } from '@/lib/seo';

const crumbs = [{ name: 'Início', path: '/' }, { name: 'Ferramentas', path: '/ferramentas' }];
---
<BaseLayout title="Ferramentas católicas: terço, novena, testes e mais" description="Terço guiado, Via Sacra, planejador de novena, consagração em 33 dias, testes de santo e temperamento, plano de leitura da Bíblia e outras ferramentas gratuitas." path="/ferramentas"
  keywords="ferramentas católicas, terço online, novena, via sacra online, teste católico, plano de leitura da bíblia"
  jsonLd={[{ '@type': 'CollectionPage', '@id': `${absUrl('/ferramentas')}#webpage`, url: absUrl('/ferramentas'), name: 'Ferramentas católicas', inLanguage: 'pt-BR', mainEntity: itemListSchema(FERRAMENTAS.map((f) => ({ name: f.titulo, path: f.href }))) }, breadcrumbSchema(crumbs)]}>
  <PageHeader title="Ferramentas" subtitle="Para rezar todos os dias, conhecer melhor a fé e os santos. Tudo gratuito, sem cadastro." icon={Wrench} crumbs={crumbs} />
  <main id="conteudo" class="py-8 md:py-12">
    <div class="container mx-auto max-w-5xl space-y-12 px-4">
      {GRUPOS_FERRAMENTAS.map((g) => (
        <section aria-labelledby={`f-${g.id}`}>
          <h2 id={`f-${g.id}`} class="mb-4 font-display text-2xl font-semibold md:text-3xl">{g.nome}</h2>
          <FerramentasGrid itens={FERRAMENTAS.filter((f) => f.grupo === g.id)} />
        </section>
      ))}
    </div>
  </main>
</BaseLayout>
