---
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/source-serif-4';
// As duas fontes do texto principal começam a baixar junto com o HTML (sem esperar o CSS)
import fonteSans from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import fonteSerif from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import '@/styles/global.css';
import Header from '@/components/astro/Header.astro';
import FaixaLiturgica from '@/components/astro/FaixaLiturgica.astro';
import Footer from '@/components/astro/Footer.astro';
import { SUPABASE_URL, SITE_NAME, DEFAULT_OG_IMAGE, GA_ID } from '@/config/site';
import { absUrl, organizationSchema, websiteSchema } from '@/lib/seo';

interface Props {
  title: string;
  description: string;
  path: string;
  keywords?: string;
  ogType?: 'website' | 'article';
  image?: string | null;
  imageAlt?: string;
  noIndex?: boolean;
  jsonLd?: Record<string, unknown>[];
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  /** Imagem principal (LCP) para pré-carregar */
  preloadImage?: string | null;
  /** srcset e sizes da imagem principal (para o preload escolher a mesma versão que a página) */
  preloadSrcset?: string;
  preloadSizes?: string;
  /** Oculta o bloco "Pedido de Oração" acima do rodapé */
  hidePrayerCTA?: boolean;
  /** Largura máxima do bloco de pedido de oração */
  ctaMaxWidth?: string;
  /** Sem cabeçalho/rodapé (ex.: painel admin) */
  bare?: boolean;
}

const {
  title,
  description,
  path,
  keywords,
  ogType = 'website',
  image,
  imageAlt,
  noIndex = false,
  jsonLd = [],
  publishedTime,
  modifiedTime,
  section,
  preloadImage,
  preloadSrcset,
  preloadSizes,
  hidePrayerCTA = false,
  ctaMaxWidth,
  bare = false,
} = Astro.props;

// O nome do site só entra quando cabe: o Google corta títulos acima de uns 60 caracteres
const fullTitle = title.includes(SITE_NAME) || title.length > 42 ? title : `${title} | ${SITE_NAME}`;
const canonical = absUrl(path.startsWith('/') ? path : `/${path}`);
const ogImage = image ? absUrl(image) : DEFAULT_OG_IMAGE;
const robots = noIndex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const graph = {
  '@context': 'https://schema.org',
  '@graph': [organizationSchema, websiteSchema, ...jsonLd],
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-BR" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta name="author" content={SITE_NAME} />
    <meta name="theme-color" content="#eee6dc" />
    <meta name="geo.region" content="BR" />
    <meta name="geo.placename" content="Brasil" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME}: novos artigos`} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {section && <meta property="article:section" content={section} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" as="font" type="font/woff2" href={fonteSans} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={fonteSerif} crossorigin />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} imagesrcset={preloadSrcset} imagesizes={preloadSrcset ? preloadSizes : undefined} fetchpriority="high" />}

    <!-- Imagens das pinturas vêm do Supabase: a conexão já abre junto com a página -->
    <link rel="preconnect" href={SUPABASE_URL} crossorigin />
    <link rel="dns-prefetch" href={SUPABASE_URL} />
    <!-- Google Analytics: a fila de eventos começa já; o script (cerca de 150 KB) só baixa depois
         que a página terminou de carregar, para não disputar banda com o conteúdo -->
    <script is:inline define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function(){ window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', GA_ID);
      (function () {
        var carregado = false;
        function carregar() {
          if (carregado) return;
          carregado = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
          document.head.appendChild(s);
        }
        ['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach(function (ev) {
          window.addEventListener(ev, carregar, { once: true, passive: true });
        });
        window.addEventListener('load', function () {
          (window.requestIdleCallback || function (f) { setTimeout(f, 1500); })(function () { setTimeout(carregar, 2500); });
        });
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />
  </head>
  <body class="min-h-screen bg-co-warm-sand font-dm-sans text-co-warm-brown antialiased">
    <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>
    {!bare && <FaixaLiturgica />}
    {!bare && <Header />}
    <slot />
    {!bare && <Footer hidePrayerCTA={hidePrayerCTA} ctaMaxWidth={ctaMaxWidth} path={path} />}
    <script>
      // Quem entrou com e-mail: junta o progresso deste aparelho com o da conta
      // Sincronização do progresso: o código só é baixado por quem entrou com e-mail
      try {
        const logado =
          /access_token=|refresh_token=|[?&]code=/.test(location.hash + location.search) ||
          Object.keys(localStorage).some((k) => /^sb-.+-auth-token$/.test(k));
        if (logado) import('@/lib/progresso').then((m) => m.iniciarSincronizacao());
      } catch {
        /* sem armazenamento */
      }
      // Pedido de oração: o modal (React) só é baixado no primeiro clique
      document.addEventListener('click', (e) => {
        const alvo = (e.target as HTMLElement | null)?.closest('[data-prayer-open]');
        if (!alvo || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        import('@/lib/pedidoDeOracao').then((m) => m.abrirPedidoDeOracao());
      });
    </script>
  </body>
</html>
