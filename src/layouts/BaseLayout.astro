---
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/source-serif-4';
// As duas fontes do texto principal começam a baixar junto com o HTML (sem esperar o CSS)
import fonteSans from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import fonteSerif from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import '@/styles/global.css';
import Header from '@/components/astro/Header.astro';
import FaixaLiturgica from '@/components/astro/FaixaLiturgica.astro';
import Footer from '@/components/astro/Footer.astro';
import { SUPABASE_URL, SITE_NAME, DEFAULT_OG_IMAGE, GTM_ID } from '@/config/site';
import { absUrl, organizationSchema, websiteSchema } from '@/lib/seo';

interface Props {
  title: string;
  description: string;
  path: string;
  keywords?: string;
  ogType?: 'website' | 'article';
  image?: string | null;
  imageAlt?: string;
  noIndex?: boolean;
  jsonLd?: Record<string, unknown>[];
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  /** Imagem principal (LCP) para pré-carregar */
  preloadImage?: string | null;
  /** srcset e sizes da imagem principal (para o preload escolher a mesma versão que a página) */
  preloadSrcset?: string;
  preloadSizes?: string;
  /** Oculta o bloco "Pedido de Oração" acima do rodapé */
  hidePrayerCTA?: boolean;
  /** Largura máxima do bloco de pedido de oração */
  ctaMaxWidth?: string;
  /** Sem cabeçalho/rodapé (ex.: painel admin) */
  bare?: boolean;
}

const {
  title,
  description,
  path,
  keywords,
  ogType = 'website',
  image,
  imageAlt,
  noIndex = false,
  jsonLd = [],
  publishedTime,
  modifiedTime,
  section,
  preloadImage,
  preloadSrcset,
  preloadSizes,
  hidePrayerCTA = false,
  ctaMaxWidth,
  bare = false,
} = Astro.props;

// O nome do site só entra quando cabe: o Google corta títulos acima de uns 60 caracteres
const fullTitle = title.includes(SITE_NAME) || title.length > 42 ? title : `${title} | ${SITE_NAME}`;
const canonical = absUrl(path.startsWith('/') ? path : `/${path}`);
const ogImage = image ? absUrl(image) : DEFAULT_OG_IMAGE;
const robots = noIndex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const graph = {
  '@context': 'https://schema.org',
  '@graph': [organizationSchema, websiteSchema, ...jsonLd],
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-BR" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta name="author" content={SITE_NAME} />
    <meta name="theme-color" content="#eee6dc" />
    <meta name="geo.region" content="BR" />
    <meta name="geo.placename" content="Brasil" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME}: novos artigos`} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {section && <meta property="article:section" content={section} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" as="font" type="font/woff2" href={fonteSans} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={fonteSerif} crossorigin />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} imagesrcset={preloadSrcset} imagesizes={preloadSrcset ? preloadSizes : undefined} fetchpriority="high" />}

    <!-- Imagens das pinturas vêm do Supabase: a conexão já abre junto com a página -->
    <link rel="preconnect" href={SUPABASE_URL} crossorigin />
    <link rel="dns-prefetch" href={SUPABASE_URL} />
    <!-- Google Tag Manager (GA4 e eventos). A fila começa já; o script só baixa depois que a página
         terminou de carregar ou na primeira interação, para não disputar banda com o conteúdo.
         Eventos do site: window.track('nome', { parametros }) ou window.gtag('event', 'nome', { parametros }). -->
    <script is:inline define:vars={{ GTM_ID }}>
      window.dataLayer = window.dataLayer || [];
      var PARAMS = ['novena','form','santo','principal','modo','ferramenta','destino','origem','link_url','link_text','method','dia','licao','acertos','total','search_term','plano','conteudo'];
      window.track = function (nome, params) {
        var ev = { event: nome };
        for (var k in (params || {})) ev[k] = params[k];
        window.dataLayer.push(ev);
        // limpa os parâmetros para não vazarem para o próximo evento
        var limpa = {};
        PARAMS.forEach(function (k) { limpa[k] = undefined; });
        window.dataLayer.push(limpa);
      };
      window.gtag = function (cmd, nome, params) { if (cmd === 'event') window.track(nome, params); };
      window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      (function () {
        var carregado = false;
        function carregar() {
          if (carregado) return;
          carregado = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtm.js?id=' + GTM_ID;
          document.head.appendChild(s);
        }
        ['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach(function (ev) {
          window.addEventListener(ev, carregar, { once: true, passive: true });
        });
        window.addEventListener('load', function () {
          (window.requestIdleCallback || function (f) { setTimeout(f, 1500); })(function () { setTimeout(carregar, 2500); });
        });
      })();
      // Cliques que importam: app, ferramentas do site e chamadas dentro dos artigos
      var FERRAMENTAS = ['/terco-guiado','/terco-da-misericordia','/laudes-de-hoje','/liturgia-diaria','/planejador-de-novena','/exame-de-consciencia','/via-sacra','/lectio-divina','/plano-de-leitura-da-biblia','/encontre-na-biblia','/santo-do-dia','/descubra-seu-santo','/padroeiros','/datas-liturgicas','/consagracao-a-nossa-senhora','/aprender','/glossario','/teste-de-temperamento','/pedido-de-oracao','/versiculo-do-dia','/santo-do-aniversario','/nomes-de-santos'];
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
        if (!a) return;
        var url;
        try { url = new URL(a.getAttribute('href'), location.href); } catch (err) { return; }
        var texto = (a.textContent || '').trim().slice(0, 80);
        if (url.hostname === 'app.catolicosorantes.com.br') {
          window.track('app_clique', { link_url: url.href, link_text: texto, origem: location.pathname });
        } else if (url.hostname === location.hostname && FERRAMENTAS.indexOf(url.pathname.replace(/\/$/, '')) >= 0) {
          window.track('ferramenta_clique', { destino: url.pathname, link_text: texto, origem: location.pathname, conteudo: a.closest('.ponte') ? 'ponte_artigo' : undefined });
        } else if (/whatsapp\.com|wa\.me/.test(url.hostname)) {
          window.track('whatsapp_clique', { link_url: url.href, origem: location.pathname });
        }
      }, true);
      // Texto copiado (orações, versículos)
      document.addEventListener('copy', function () { window.track('texto_copiado', { origem: location.pathname }); });
      // Busca interna: registra o termo quando a pessoa para de digitar
      var tBusca;
      document.addEventListener('input', function (e) {
        var el = e.target;
        if (!el || !el.matches || !el.matches('[data-search-input]')) return;
        clearTimeout(tBusca);
        tBusca = setTimeout(function () { var t = el.value.trim(); if (t.length >= 3) window.track('search', { search_term: t.slice(0, 100) }); }, 1500);
      });
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />
  </head>
  <body class="min-h-screen bg-co-warm-sand font-dm-sans text-co-warm-brown antialiased">
    <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>
    {!bare && <FaixaLiturgica />}
    {!bare && <Header />}
    <slot />
    {!bare && <Footer hidePrayerCTA={hidePrayerCTA} ctaMaxWidth={ctaMaxWidth} path={path} />}
    <script>
      // Quem entrou com e-mail: junta o progresso deste aparelho com o da conta
      // Sincronização do progresso: o código só é baixado por quem entrou com e-mail
      try {
        const logado =
          /access_token=|refresh_token=|[?&]code=/.test(location.hash + location.search) ||
          /(^|; )sb-[^=]+-auth-token\.0=/.test(document.cookie) ||
          Object.keys(localStorage).some((k) => /^sb-.+-auth-token$/.test(k));
        if (logado) import('@/lib/progresso').then((m) => m.iniciarSincronizacao());
      } catch {
        /* sem armazenamento */
      }
      // Pedido de oração: o modal (React) só é baixado no primeiro clique
      document.addEventListener('click', (e) => {
        const alvo = (e.target as HTMLElement | null)?.closest('[data-prayer-open]');
        if (!alvo || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        import('@/lib/pedidoDeOracao').then((m) => m.abrirPedidoDeOracao());
      });
    </script>
  </body>
</html>
